<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS + HttpPlatformHandler.

  O IIS não executa Python. Este arquivo faz o IIS subir o uvicorn como
  processo filho numa porta que ele mesmo escolhe (%HTTP_PLATFORM_PORT%) e
  encaminhar tudo para lá. Requer o módulo HttpPlatformHandler instalado:
  https://www.iis.net/downloads/microsoft/httpplatformhandler

  AJUSTE os três caminhos marcados com <<< antes de usar.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*"
           modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>

    <httpPlatform
        processPath="C:\inetpub\yargen\.venv\Scripts\python.exe"        
        arguments="-m webapp.server --host 127.0.0.1 --port %HTTP_PLATFORM_PORT%"
        stdoutLogEnabled="true"
        stdoutLogFile="C:\inetpub\yargen\logs\stdout"                   
        startupTimeLimit="180"
        startupRetryCount="2"
        requestTimeout="00:10:00">
      <environmentVariables>
        <!-- Raiz do projeto, para `-m webapp.server` encontrar os pacotes. -->
        <environmentVariable name="PYTHONPATH" value="C:\inetpub\yargen" />

        <!-- Onde ficam uploads e charts gerados. A identidade do pool de
             aplicativos PRECISA ter permissão de escrita aqui. -->
        <environmentVariable name="YARGEN_WORKSPACE" value="C:\yargen\workspace" />

        <!-- Obrigatório. O Demucs baixa os pesos para %USERPROFILE%\.cache,
             e a identidade do pool de aplicativos normalmente não tem
             perfil de usuário: sem estas duas, a separação de stems falha
             com erro de permissão na primeira execução. -->
        <environmentVariable name="TORCH_HOME" value="C:\yargen\torch" />
        <environmentVariable name="HF_HOME" value="C:\yargen\huggingface" />

        <environmentVariable name="YARGEN_MAX_UPLOAD_MB" value="80" />
        <environmentVariable name="PYTHONUNBUFFERED" value="1" />
      </environmentVariables>
    </httpPlatform>

    <security>
      <requestFiltering>
        <!-- O padrão do IIS são 30 MB e ele rejeita o upload ANTES de chegar
             no Python, com um 404.13 que não explica nada. Mantenha este
             valor acima de YARGEN_MAX_UPLOAD_MB. 100 MB aqui. -->
        <requestLimits maxAllowedContentLength="104857600" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
